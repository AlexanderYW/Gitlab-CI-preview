{
  "name": "@gitlab-ci-preview/server",
  "version": "0.5.0",
  "main": "./dist/server.js",
  "scripts": {
    "build": "bun build src/server.ts --target=node --format=cjs --outfile=dist/server.js --external vscode",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "bun build src/server.ts --target=node --format=cjs --outfile=dist/server.js --watch --external vscode"
  },
  "dependencies": {
    "@gitlab-ci-preview/shared": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.1.0",
    "yaml": "^2.9.0"
  }
}
