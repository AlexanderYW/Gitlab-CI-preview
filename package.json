{
  "name": "gitlab-ci-preview",
  "private": true,
  "version": "0.5.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "bun run --filter '*' build",
    "build:shared": "bun run --cwd packages/shared build",
    "build:server": "bun run --cwd packages/server build",
    "build:client": "bun run --cwd packages/client build",
    "build:webview": "bun run --cwd packages/webview build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint \"packages/**/*.{ts,tsx}\"",
    "test": "bun test",
    "package": "bash scripts/package.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google/semantic-release-replace-plugin": "^1.2.7",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.3",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.8.1",
    "ovsx": "^1.1.1",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
